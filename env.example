# Rename this file to .env and fill in your values

# Your bot's token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Your bot's Application (Client) ID, from the General Information page
CLIENT_ID=

# Optional: the ID of the server you're testing in. Guild-specific command
# deployment is instant. Leave blank to deploy commands globally (takes up to 1 hour).
GUILD_ID=

# Optional: how often (in minutes) the bot checks for new AION 2 news to
# auto-post. Defaults to 30 if left blank.
AION2_CHECK_INTERVAL_MINUTES=30

# Optional: a residential proxy for yt-dlp to route through, which helps a
# lot with YouTube's bot-detection (Railway's datacenter IP is what gets
# flagged). Format: http://username:password@host:port
# See README.md for where to get one.
YT_PROXY=
